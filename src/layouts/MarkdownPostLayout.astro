---
import TagLink from "@/components/TagLink.astro";
import Layout from "@/layouts/Layout.astro";

const { frontmatter } = Astro.props;
const { title, image, author, tags, description } = frontmatter;
const { url, alt } = image;
---

<Layout title={title} isOnMdLayout={true} description={description}>
  <style is:inline slot="styles">
    .author {
      font-size: 1.3rem;
    }

    img {
      width: 100%;
      height: auto;
      aspect-ratio: 16/9;
      background-color: rgb(177, 177, 177);
      border-radius: 10px;
    }

    .tags {
      display: grid;
      width: 100%;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      justify-items: start;
      align-items: center;
      margin-bottom: 10px;
      font-size: 0.8rem;

      li {
        list-style-type: none;

        small {
          a {
            color: rgb(16, 77, 16);
            text-decoration: none;
          }
        }
      }
    }
  </style>
  <p class="author">Written by <strong>{author}</strong></p>
  <img src={url} alt={alt} loading="lazy" fetchpriority="high" />
  <slot />
  <strong>Tags/keywords: </strong>
  <ul class="tags">
    {tags.map((tag: string) => <TagLink tagName={tag} />)}
  </ul>
</Layout>
