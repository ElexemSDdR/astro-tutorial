---
import Layout from "@/layouts/Layout.astro";

const { frontmatter } = Astro.props;
const { title, image, author, tags } = frontmatter;
const { url, alt } = image;
---

<Layout title={title} isOnMdLayout={true}>
  <style is:inline slot="styles">
    .author {
      font-size: 1.3rem;
    }

    img {
      width: 100%;
      height: auto;
    }

    .tags {
      display: grid;
      width: 100%;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      justify-items: start;
      align-items: center;
      margin-bottom: 10px;

      li {
        list-style-type: none;

        small {
          color: rgb(16, 77, 16);
        }
      }
    }
  </style>
  <p class="author">Written by <strong>{author}</strong></p>
  <img src={url} alt={alt} />
  <slot />
  <strong>Tags/keywords: </strong>
  <ul class="tags">
    {
      tags.map((tag: string) => (
        <li>
          <small>"{tag}"</small>
        </li>
      ))
    }
  </ul>
</Layout>
