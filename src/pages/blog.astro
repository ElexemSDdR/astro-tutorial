---
import BlogPostLink from "@/components/BlogPostLink.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import { getCollection } from "astro:content";

const pageTitle = "Blog";
const allBlogs = await getCollection("blog");
---

<Layout title={pageTitle} description="See some posts">
  <h2>Welcome to my blog</h2>
  <p>
    This is the blog section of the Astro oficial tutorial, being this the third
    page created
  </p>
  <p>
    This supposed to be my posts about my journey learning Astro, so take a look
    of this
  </p>
  <h3>See the incoming posts here</h3>
  <ul class="blogs-list">
    {
      allBlogs.map((post: any) => (
        <BlogPostLink url={`/posts/${post.id}/`} title={post.data.title} />
      ))
    }
  </ul>
</Layout>
