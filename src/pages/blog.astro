---
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";

const pageTitle = "Blog";

const posts = ['post-1', 'post-2', 'post-3',]
---

<Layout title={pageTitle}>
      <h2>Welcome to my blog</h2>
      <p>
        This is the blog section of the Astro oficial tutorial, being this the
        third page created
      </p>
      <p>
        This supposed to be my posts about my journey learning Astro, so take a
        look of this
      </p>
      <h3>See the incoming posts here</h3>
      <ul>
        {
          posts.map((post, index) => (
            <li><a href=`/posts/${post}` >Post {index + 1}</a></li>
          ))
        }
      </ul>
</Layout>
