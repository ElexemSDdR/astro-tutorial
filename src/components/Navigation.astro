---
interface Props {
  isOnMdLayout: boolean;
}

const { isOnMdLayout } = Astro.props;
---

<nav id="navigation">
  <ul>
    {
      isOnMdLayout ? (
        <li><a class="header-links" href="/blog">Back to blogs</a></li>
        <li><a class="header-links" href="/tags">Blog tags</a></li>
      ) : ( 
        <li><a class="header-links" href="/">Home</a></li>
        <li><a class="header-links" href="/about">About</a></li>
        <li><a class="header-links" href="/blog">Blog</a></li>
        <li><a class="header-links" href="/tags">Blog tags</a></li>
      )
    }
  </ul>
</nav>

<style>
  nav,
  ul,
  a {
    width: 100%;
  }

  nav {
    ul {
      display: flex;
      justify-content: space-evenly;
      padding: 0;

      li {
        list-style: none;
        flex: 1;

        .header-links {
          padding-block: 10px;
          box-shadow: 0px -8px 8px -6px light-dark(var(--bg-light), var(--bg-dark)) inset;
          text-align: center;
          align-items: center;
          justify-content: center;
          color: white;
          font-size: 1.2rem;
          margin: 0;
          text-decoration: none;
          font-weight: bold;
          display: flex;
          transition: background 0.1s ease-in-out, box-shadow 0.1s ease-in-out;

          &:hover, &:focus {
            background-color: rgba(255, 255, 255, 0.074);
            box-shadow: 0px -12px 8px -6px light-dark(var(--bg-light), var(--bg-dark)) inset;
          }

          &::after {
            display: none;
          }
        }
      }
    }
  }

  @media screen and (width < 920px) {
    nav {
      width: 210px;
      color: black;
      position: fixed;
      position-anchor: --menu-button;
      justify-self: anchor-center;
      top: anchor(bottom);
      left: anchor(left);
      right: anchor(right);
      z-index: 1000;

      ul {
        margin-block: 15px;
        max-width: 100%;
        border-radius: 10px;
        overflow: hidden;
        flex-direction: column;

        li {
          margin: 0;
          padding: 0;

          a {
            box-shadow: none;
            color: #ededed;
            background-image: linear-gradient(
              to bottom,
              #671739 0%,
              #480b1d 50%,
              #671739 100%
            );
            background-size: cover;
            background-position-y: 0px;
            background-size: 1250px;
            transition: background-position 0.2s ease-in-out;

            &:hover {
              background-position-y: -20px;
            }
          }
        }
      }
    }
  }
</style>