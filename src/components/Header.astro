---
import Menu from "@/components/Menu.astro";
import Navigation from "@/components/Navigation.astro";

interface Props {
  pageTitle: string;
  isOnMdLayout: boolean;
}

const { pageTitle, isOnMdLayout } = Astro.props;
---

<header>
  <h1>{pageTitle}</h1>
  <Menu />
  <Navigation isOnMdLayout={isOnMdLayout} />
</header>

<style>
  header {
    width: 100%;
    display: grid;
    grid-template-rows: repeat(1fr, 2);
    place-items: center;
    padding: 0;
    position: relative;
    anchor-name: --header;
  }

  @media screen and (width < 920px) {
    header {
      .menu[aria-expanded="false"] + nav {
        visibility: hidden;
      }
    }
  }
</style>
