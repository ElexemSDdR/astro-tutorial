---
interface Props {
  url: string;
  title: string;
}

const { title, url } = Astro.props;
---

<style>
  .blog-link {
    color: rgb(57, 24, 167);
    text-decoration: none;
    position: relative;
    margin-bottom: 5px;
    padding-bottom: 3px;

    &::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      background-color: rgb(57, 24, 167);
      width: 0%;
      height: 2px;
      transition: width 0.1s ease-in-out;
    }

    &:hover {
      &::after {
        width: 100%;
      }
    }
  }
</style>

<li>
  <a class="blog-link" href={url}>{title}</a>
</li>
